# Non-secret settings for the Mu2e kb-mcp deployment.
#
# This file is in git and ships inside the installed venv as
# share/kb-mcp/mu2e.env, so changing a setting here means committing and
# cutting a release -- deliberately. It is never read from a working
# checkout, where an edit would take effect immediately with no review.
#
# Three places hold configuration, and the split is on purpose:
#
#   this file    policy that is the same on every host: ports, bind
#                addresses, auth mode, embedding provider, log levels.
#                No absolute paths -- it cannot know the deploy root.
#   the unit     deployment paths, filled in by kb-mcp-install-unit.sh from
#                its arguments: DATA_DIR, HF_HOME, MIKEY_KEYS_FILE.
#   KB_ENV_FILE  secrets AND site topology (database host/name/user, LLM
#                endpoint), mode 600, outside git.
#
# Load order is systemd EnvironmentFile (this file) -> unit Environment= ->
# KB_ENV_FILE, and kb_mcp.env loads that last with override=True, so anything
# in the private file always wins over a default set here.
#
# Format note: systemd parses EnvironmentFile as plain KEY=VALUE. No `export`,
# no shell expansion, no comments after a value on the same line. Values
# containing spaces are quoted -- systemd strips the quotes, and it keeps the
# file sourceable from a shell for debugging.

# --- MCP endpoint ----------------------------------------------------------
# Port 8008 by Mu2e convention; the aitools registry reserves 8000-8009 for
# MCP servers and this is kb's slot.
PORT=8008
# Reachable across the lab network; outside traffic is blocked by firewall,
# and the endpoint itself is gated by MCP_REQUIRE_API_KEY below.
MCP_HOST=0.0.0.0
# Plain HTTP, like the other Mu2e MCP servers. USE_HTTPS=true (the default)
# would make the server look for certs/key.pem relative to its working
# directory and fail.
USE_HTTPS=false

# --- Web UI ----------------------------------------------------------------
# Loopback only, reached over an ssh tunnel:
#   ssh -L 8108:localhost:8108 <host>
# Bound to loopback and served in public mode: browsing needs no session, and
# the write/admin pages are gated by ADMIN_PASSWORD (a secret). Loopback keeps
# it off the network, but every account on this host can still reach it
# through an ssh tunnel, so ADMIN_PASSWORD is what actually protects writes.
WEB_HOST=127.0.0.1
# Set explicitly: WEB_PORT defaults to PORT+1, which would be 8009 and sit
# inside the 8000-8009 range the aitools registry reserves for MCP servers.
# 8108 is 8008 + 100, so the web port for an MCP server is readable off its
# MCP port. The unit passes --web-port too, so this is the fallback.
WEB_PORT=8108
# No OAuth provider is configured, so there is no per-user login to perform.
WEB_REQUIRE_AUTH=false
# REQUIRED with WEB_REQUIRE_AUTH=false. Public mode serves the browsable pages
# with no session at all and sends /login to /admin/login, so the write pages
# stay behind ADMIN_PASSWORD.
#
# With both false, /web redirects to /login and /login silently mints a session
# carrying has_admin=True -- no password, no check -- so anyone who can reach
# the port gets upload, delete, re-chunk and API-key management. Note that
# binding to loopback does not prevent that on a shared interactive node: any
# account on the host can forward a tunnel to 127.0.0.1:8108.
WEB_PUBLIC_MODE=true
SITE_NAME="Mu2e Knowledge Base"
HIDE_GRAPH=false

# --- Authentication --------------------------------------------------------
# The MCP endpoint is on the network, so it requires a bearer token. Tokens
# come from the shared mikey key store used by the other Mu2e MCP servers;
# the unit supplies MIKEY_KEYS_FILE.
DISABLE_AUTH=false
MCP_REQUIRE_API_KEY=true

# --- Embedding -------------------------------------------------------------
# MUST match what the indexed chunks were embedded with: a query is embedded
# at read time and compared in the same vector space, so a mismatch returns
# plausible-looking nonsense rather than an error.
EMBEDDING_PROVIDER=st
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_STRATEGY=section

# --- Not here: database and LLM endpoint -----------------------------------
# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_SCHEMA and OPENAI_BASE_URL are set in
# KB_ENV_FILE, not in this file. They are not secrets, but they describe
# internal infrastructure -- which hosts exist, what they are called, which
# account connects -- and this repository is public. Keeping site topology out
# of it costs nothing and removes a free reconnaissance step.
#
# There is still no database *password* anywhere: the connection authenticates
# with Kerberos/GSSAPI from the service account's ambient credentials, and
# get_database_url() builds a password-less URL when DB_PASSWORD is unset.
# Set DB_HOSTADDR too when connecting through a tunnel -- libpq derives the
# GSSAPI principal from DB_HOST, not from the actual TCP target.

# --- LLM model -------------------------------------------------------------
# The default is a Gemini model name, which is wrong for an OpenAI-compatible
# endpoint: the agent tool (kb_research), summaries and graph extraction would
# all ask for a model the endpoint does not serve. A model name is policy, not
# site topology, so it belongs here rather than in KB_ENV_FILE.
DEFAULT_LLM_MODEL=gpt-oss:120b

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
MCP_LOG_LEVEL=INFO
