# Mu2e developer configuration for kb-mcp: copy to .env and fill in the
# <placeholders>. See docs/guides/install-mu2e-dev.md.
#   install -m 600 .env.mu2e.example .env
# Secrets go in .env.local, never here. All settings are explained in .env.example.

# Database (values from a maintainer).
# Production: Kerberos login as yourself; keep DB_USER=${USER}, no password.
# Dev database: its DB_USER here, DB_PASSWORD in .env.local.
DB_HOST=<database-host>
DB_PORT=<database-port>
DB_NAME=<database-name>
DB_SCHEMA=<schema>
DB_USER=${USER}

# Must match the existing corpus; changing them needs a full re-embed.
EMBEDDING_PROVIDER=st
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_STRATEGY=section

# Text model on the Fermilab vLLM service (no key; "notused" fills the slot).
DEFAULT_LLM_MODEL=gpt-oss:120b
OPENAI_BASE_URL_MODELS={"gpt-oss:120b": "https://vllm.fnal.gov/v1/"}
OPENAI_API_KEY_MODELS={"gpt-oss:120b": "notused"}

# Vision model on ALCF; scripts/setup_alcf.sh writes its endpoint and token
# (OPENAI_BASE_URL / OPENAI_API_KEY) into .env.local.
PARSE_IMAGE_DESCRIPTION_MODEL=google/gemma-4-31B-it
PARSE_IMAGE_ADDITIONAL_DOC=true
PARSE_IMAGE_LLM_DESCRIPTION=true
PARSE_FORMULA_ENRICHMENT_AUTO=true

# Local servers: loopback only, no login. Pick free ports (node is shared).
MCP_HOST=127.0.0.1
WEB_HOST=127.0.0.1
PORT=<mcp-port>
WEB_PORT=<web-port>
USE_HTTPS=false
BASE_URL=http://127.0.0.1
DISABLE_AUTH=true
SITE_NAME="Mu2e Knowledge Base (dev)"
HIDE_GRAPH=true
LOG_LEVEL=INFO
MCP_LOG_LEVEL=INFO

# API keys, sessions, uploads.
DATA_DIR=/exp/mu2e/data/users/${USER}/kb-mcp-data
