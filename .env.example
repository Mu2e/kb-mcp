# Server Configuration
BASE_URL=https://127.0.0.1
PORT=8443
HOST=127.0.0.1
USE_HTTPS=true

# Upload Configuration
# Maximum file upload size in bytes (default: 104857600 = 100MB)
MAX_UPLOAD_SIZE=104857600

# Logging Configuration
# LOG_LEVEL: Log level for third-party libraries (httpx, httpcore, mcp, etc)
# MCP_LOG_LEVEL: Log level for our code (kb_mcp.server, kb_mcp.oauth)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
MCP_LOG_LEVEL=INFO

# Audit Logging
# Log all tool calls with username, tool name, and arguments
# Set AUDIT_LOG_FILE to a file path to enable audit logging to that file
# Leave empty to disable audit logging
AUDIT_LOG_FILE=

# ============================================================================
# Authentication Configuration
# ============================================================================

# Authentication Mode
# Set to "true" to disable authentication for both MCP and web (for local development only)
# Default: false (authentication enabled)
# WARNING: Only use DISABLE_AUTH=true for development or localhost-only bindings
DISABLE_AUTH=false

# OAuth Provider Configuration (choose one: GitHub or Globus)
# Only configure one OAuth provider. If both are set, the server will raise an error.
# If no OAuth provider is configured:
#   - MCP clients: Must use API keys for authentication
#   - Web interface: Will be blocked (requires OAuth)

# GitHub OAuth Configuration
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set the callback URL to: {BASE_URL}/oauth/callback
GITHUB_CLIENT_ID=YOUR-GITHUB-CLIENT-ID
GITHUB_CLIENT_SECRET=YOUR-GITHUB-CLIENT-SECRET
# Restrict access to users who have access to a specific GitHub repository
# Format: owner/repo (e.g., "myorg/private-repo")
# Leave empty to allow all authenticated GitHub users
GITHUB_REQUIRED_REPO=

# Globus OAuth Configuration
# Create a Globus OAuth App at https://developers.globus.org/
# Set the callback URL to: {BASE_URL}/oauth/callback
GLOBUS_CLIENT_ID=YOUR-GLOBUS-CLIENT-ID
GLOBUS_CLIENT_SECRET=YOUR-GLOBUS-CLIENT-SECRET
# Restrict access to users in a specific Globus group
# Format: Globus group UUID (e.g., "6207971f-dd5b-11f0-945c-0e587dcf26df")
# Leave empty to allow all authenticated Globus users
GLOBUS_REQUIRED_GROUP=

# API Key Configuration
# API keys are always available and can be used for MCP authentication
# API keys cannot be used for web interface authentication (web requires OAuth)
# Path to API keys file (default: data/api_keys.json)
API_KEYS_FILE=data/api_keys.json

# Web Session Configuration
# Session timeout in seconds for web interfaces (/admin and /web)
# Uses sliding expiration: timeout extends on each request
# Default: 86400 (24 hours)
WEB_SESSION_TIMEOUT=86400

# Web Session Re-verification Interval
# How often to re-verify OAuth permissions (in seconds)
# Sessions are re-verified with the OAuth provider periodically to detect permission changes
# Default: 3600 (1 hour)
WEB_REVERIFY_INTERVAL=3600

# Session Storage Backend
# Set to "true" to use Firestore for session storage (requires GCP setup)
# Default: false (uses local file storage)
SESSION_STORE_FIRESTORE=false

# OAuth Token Timeouts (MCP OAuth flow)
# Authorization code expiration time in seconds
# Default: 600 (10 minutes)
OAUTH_AUTHORIZATION_CODE_TIMEOUT=600

# OAuth state parameter expiration time in seconds (for web and MCP OAuth flows)
# Default: 600 (10 minutes)
OAUTH_STATE_TIMEOUT=600

# MCP access token expiration time in seconds
# Default: 3600 (1 hour)
OAUTH_ACCESS_TOKEN_TIMEOUT=3600

# ============================================================================
# LLM Configuration
# ============================================================================

# OpenAI API Configuration
# Required for LLM features (summarization, evaluation, image descriptions)
OPENAI_API_KEY=
# Optional: Custom base URL for OpenAI-compatible API (e.g., for local models or ALCF)
OPENAI_BASE_URL=

# Default LLM Model (fallback for all operations)
# DEFAULT_LLM_MODEL is used as a fallback when specific model settings are not set.
# Specific model settings (SUMMARY_MODEL, EVAL_GEN_MODEL, etc.) override this default.
# If not set, defaults to: gemini-2.5-flash-lite
DEFAULT_LLM_MODEL=

# Specific LLM Model Settings (override DEFAULT_LLM_MODEL when set)
# Document summarization model (defaults to DEFAULT_LLM_MODEL if not set)
SUMMARY_MODEL=

# Evaluation Configuration
# Model for generating evaluation questions (defaults to DEFAULT_LLM_MODEL if not set)
EVAL_GEN_MODEL=
# Model for judging answer quality (defaults to DEFAULT_LLM_MODEL if not set)
EVAL_JUDGE_MODEL=

# Image Description Model
# Model for generating LLM descriptions of images during parsing
# (defaults to DEFAULT_LLM_MODEL if not set)
PARSE_IMAGE_DESCRIPTION_MODEL=

# ============================================================================
# Document Processing Configuration
# ============================================================================

# Document Parser Configuration
# Image extraction: create separate Document objects for images
# Set to "true" to create separate Document objects for extracted images
PARSE_IMAGE_ADDITIONAL_DOC=false

# Image LLM descriptions: generate LLM descriptions for images
# Set to "true" to enable LLM-based image description generation
PARSE_IMAGE_LLM_DESCRIPTION=false

# LLM configuration for image descriptions
# Model name for generating image descriptions (defaults to DEFAULT_LLM_MODEL)
# Number of workers for parallel image description processing (see config.py for default)
PARSE_IMAGE_DESCRIPTION_NUMWORKERS=
# Embedding Configuration
# Embedding provider (see config.py for default)
# Options: 'st', 'openai', etc.
EMBEDDING_PROVIDER=

# Specific embedding model name (provider-dependent)
# For 'st': e.g., 'all-MiniLM-L6-v2'
# For 'openai': e.g., 'text-embedding-3-small'
EMBEDDING_MODEL=

# Chunking strategy for documents (see config.py for default)
# Options: 'tokens', 'recursive', 'semantic', etc.
CHUNK_STRATEGY=

# ============================================================================
# Search Configuration
# ============================================================================

# Maximum chunks per document in search results
# Controls diversity by limiting how many chunks from a single document appear in results
# Default: 10
SEARCH_MAX_CHUNKS_PER_DOC=10

# Initial chunk retrieval multiplier
# Multiplier for initial chunk retrieval before deduplication (max_results * multiplier)
# Higher values improve result quality but use more memory
# Default: 50
SEARCH_INITIAL_LIMIT_MULTIPLIER=50

# Reciprocal Rank Fusion constant for hybrid search
# Controls how conservative the fusion of semantic and full-text results is
# Higher values give less weight to top-ranked items
# Default: 60
SEARCH_RRF_K=60

# ============================================================================
# Database Configuration
# ============================================================================

# For PostgreSQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=user
# DB_PASSWORD=password
# DB_NAME=dbname
# DB_SCHEMA=public

# For SQLite (default, development):
# SQLITE_DB_PATH=data/kb.db

# ============================================================================
# Data Directory
# ============================================================================

# Directory for storing data files (default: data)
DATA_DIR=data
